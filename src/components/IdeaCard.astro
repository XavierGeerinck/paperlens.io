---
import type { CollectionEntry } from 'astro:content';
import { FileText, Lightbulb, ArrowRight } from 'lucide-react';

interface Props {
  idea: CollectionEntry<'ideas'>;
  variant?: 'standard' | 'featured';
}

const { idea, variant = 'standard' } = Astro.props;
const { title, subtitle, status, coverImage, tags, impact, readTime, category } = idea.data;

const statusColors: Record<string, string> = {
  RESEARCH: 'border-purple-500/30 text-purple-400',
  CONCEPT: 'border-blue-500/30 text-blue-400',
  PROTOTYPE: 'border-zinc-800 text-zinc-500',
  ALPHA: 'border-emerald-500/30 text-emerald-400',
  ARCHIVED: 'border-zinc-500/30 text-zinc-400',
};

const Icon = category === 'paper' ? FileText : Lightbulb;
---

{variant === 'featured' ? (
  <a
    href={`/idea/${idea.slug}/`}
    class="relative block bg-zinc-950 border border-zinc-800 group hover:border-zinc-600 transition-colors h-full hover:bg-zinc-900/30"
  >
    <!-- Corner decorations -->
    <div class="absolute -top-[1px] -left-[1px] w-2 h-2 border-t border-l border-zinc-500"></div>
    <div class="absolute -top-[1px] -right-[1px] w-2 h-2 border-t border-r border-zinc-500"></div>
    <div class="absolute -bottom-[1px] -left-[1px] w-2 h-2 border-b border-l border-zinc-500"></div>
    <div class="absolute -bottom-[1px] -right-[1px] w-2 h-2 border-b border-r border-zinc-500"></div>

    <div class="grid md:grid-cols-2 gap-0">
      <div class="aspect-video overflow-hidden border-r border-zinc-800">
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
        />
      </div>
      <div class="p-6 flex flex-col justify-center">
        <div class="flex items-center justify-between mb-4">
          <div class="p-1.5 border border-zinc-800 bg-zinc-900 text-zinc-500 group-hover:text-indigo-400 group-hover:border-indigo-500/30 transition-colors">
            <Icon className="w-4 h-4" />
          </div>
          <span class={`inline-flex items-center px-2 py-1 text-[10px] font-mono uppercase tracking-wider border bg-zinc-900/50 ${statusColors[status]}`}>
            {status}
          </span>
        </div>
        <h3 class="text-xl font-bold text-zinc-100 mb-2 font-space leading-tight group-hover:text-indigo-300 transition-colors">
          {title}
        </h3>
        <p class="text-sm text-zinc-500 leading-relaxed mb-6 font-mono line-clamp-3">
          {subtitle}
        </p>
        <div class="pt-4 border-t border-zinc-800/50 mt-auto">
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.slice(0, 4).map((tag) => (
              <span class="text-[9px] text-zinc-600 uppercase font-mono bg-zinc-900 px-1.5 py-0.5">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex items-center justify-between text-zinc-600 group-hover:text-zinc-300 transition-colors">
            <span class="text-[9px] font-mono uppercase tracking-widest">View Specs</span>
            <ArrowRight className="w-3 h-3" />
          </div>
        </div>
      </div>
    </div>
  </a>
) : (
  <a
    href={`/idea/${idea.slug}/`}
    class="relative bg-zinc-950 border border-zinc-800 group hover:border-zinc-600 transition-colors h-full flex flex-col hover:bg-zinc-900/30"
  >
    <!-- Corner decorations -->
    <div class="absolute -top-[1px] -left-[1px] w-2 h-2 border-t border-l border-zinc-500"></div>
    <div class="absolute -top-[1px] -right-[1px] w-2 h-2 border-t border-r border-zinc-500"></div>
    <div class="absolute -bottom-[1px] -left-[1px] w-2 h-2 border-b border-l border-zinc-500"></div>
    <div class="absolute -bottom-[1px] -right-[1px] w-2 h-2 border-b border-r border-zinc-500"></div>

    <div class="p-5 flex flex-col h-full">
      <div class="flex justify-between items-start mb-4">
        <div class="p-1.5 border border-zinc-800 bg-zinc-900 text-zinc-500 group-hover:text-indigo-400 group-hover:border-indigo-500/30 transition-colors">
          <Icon className="w-4 h-4" />
        </div>
        <span class={`inline-flex items-center px-2 py-1 text-[10px] font-mono uppercase tracking-wider border bg-zinc-900/50 ${statusColors[status]}`}>
          {status}
        </span>
      </div>

      <h3 class="text-lg font-bold text-zinc-100 mb-2 font-space leading-tight group-hover:text-indigo-300 transition-colors">
        {title}
      </h3>
      <p class="text-sm text-zinc-500 leading-relaxed mb-6 font-mono line-clamp-3 flex-grow">
        {subtitle}
      </p>

      <div class="pt-4 border-t border-zinc-800/50 mt-auto">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-[9px] text-zinc-600 uppercase font-mono bg-zinc-900 px-1.5 py-0.5">
              {tag}
            </span>
          ))}
        </div>
        <div class="flex items-center justify-between text-zinc-600 group-hover:text-zinc-300 transition-colors">
          <span class="text-[9px] font-mono uppercase tracking-widest">View Specs</span>
          <ArrowRight className="w-3 h-3" />
        </div>
      </div>
    </div>
  </a>
)}
