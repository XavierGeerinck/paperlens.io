---
/**
 * Title bar — tmux-style numbered windows. The digits are real: 0-3 switch
 * windows from anywhere on the site (see src/scripts/tui.ts).
 */
interface Props {
  current?: 'home' | 'papers' | 'whoami' | 'rss';
  count?: number;
}

const { current = 'home', count } = Astro.props;

const windows = [
  { key: '0', label: 'home', href: '/', id: 'home' },
  { key: '1', label: 'papers', href: '/#papers', id: 'papers' },
  { key: '2', label: 'whoami', href: '/#whoami', id: 'whoami' },
  { key: '3', label: 'rss', href: '/rss.xml', id: 'rss' },
];
---

<header class="titlebar" role="banner">
  <span class="win"><a href="/">paperlens</a></span>

  <nav class="tabs" aria-label="Sections">
    {windows.map((w) => (
      <a
        class="tab"
        href={w.href}
        data-key={w.key}
        aria-current={current === w.id ? 'page' : undefined}
      >
        <span class="n">{w.key}:</span>{w.label}
      </a>
    ))}
  </nav>

  <div class="right">
    {count !== undefined && <span class="pill ok hidden md:inline">{count} entries</span>}
    <button class="tab" type="button" data-action="help" title="Key map (?)" aria-label="Key map">?</button>
  </div>
</header>
