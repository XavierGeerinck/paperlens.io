---
/**
 * Status bar — fixed to the bottom of every page.
 * Segments carry real state: mode, buffer path, position, live key hints.
 */
interface Props {
  path: string;
  meta?: string;
  /** rendered as HTML so key names can be bolded */
  keys?: string;
  /** right-hand segments; the article page passes its scroll meter */
  scrollMeter?: boolean;
  position?: string;
  exitCode?: string;
}

const {
  path,
  meta,
  keys = '<b>?</b> keys',
  scrollMeter = false,
  position,
  exitCode,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="statusbar" role="contentinfo">
  <span class="seg mode" data-mode="NORMAL">NORMAL</span>
  <span class="seg">{path}</span>
  {position && <span class="seg hide-sm" id="pl-pos">{position}</span>}
  {exitCode && <span class="seg c-red hide-sm">{exitCode}</span>}
  {meta && <span class="seg hide-sm">{meta}</span>}
  <span class="seg grow keys hide-sm" set:html={keys} />
  <!-- the key hints carry the flex-grow on wide screens; this takes over below 720px -->
  <span class="seg grow spacer" />
  {scrollMeter ? (
    <>
      <span class="seg" id="pl-ln">Ln 1/1</span>
      <span class="seg" id="pl-pct">Top</span>
    </>
  ) : (
    <span class="seg">© {year}<span class="hide-sm">&nbsp;Xavier Geerinck</span></span>
  )}
</footer>
