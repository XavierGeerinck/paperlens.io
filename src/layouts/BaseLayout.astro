---
import { ViewTransitions } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import GameOfLife from '../components/react/GameOfLife';
import '../styles/global.css';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  date?: Date;
  dateModified?: Date;
  keywords?: string[];
  citation?: string[];
  section?: string;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  /** KaTeX styles are ~24KB of render-blocking CSS; only pages with math pay for them */
  math?: boolean;
}

const {
  title,
  description,
  image,
  type,
  date,
  dateModified,
  keywords,
  citation,
  section,
  breadcrumbs,
  schema,
  math = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0f13" />
    <meta name="color-scheme" content="dark" />
    <SEO
      {title}
      {description}
      {image}
      {type}
      {date}
      {dateModified}
      {keywords}
      {citation}
      {section}
      {breadcrumbs}
      {schema}
    />
    <ViewTransitions />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- One typeface: Geist Mono, served from this origin (see src/styles/global.css) -->
    <link
      rel="preload"
      href="/fonts/geist-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {/* KaTeX, vendored by scripts/prebuild.ts so the stylesheet matches the version
        rehype-katex renders with, and so no CDN sits on the critical path */}
    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}

    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <main transition:animate="fade">
      <slot />
    </main>

    <!-- Easter egg: ↑↑↓↓←→←→BA -->
    <GameOfLife client:idle />

    <script>
      import '../scripts/tui.ts';

      // Mermaid is ~450KB of JavaScript. Most pages have no diagram at all, so
      // it is fetched only once one is actually on the page.
      const loadMermaid = () => {
        if (document.querySelector('.mermaid-diagram:not(.mermaid-rendered)')) {
          import('../lib/mermaid-init.ts');
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadMermaid);
      } else {
        loadMermaid();
      }
      document.addEventListener('astro:page-load', loadMermaid);
    </script>
  </body>
</html>
