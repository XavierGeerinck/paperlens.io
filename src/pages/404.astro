---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HelpOverlay from '../components/HelpOverlay.astro';

// three real entries, so the 404 hands the reader somewhere to go
const all = await getCollection('ideas');
const suggestions = all
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    slug: entry.slug,
    file: `${entry.slug}.${entry.id.endsWith('.mdx') ? 'mdx' : 'md'}`,
    subtitle: entry.data.subtitle,
  }));
---

<BaseLayout title="Not found" description="That path does not exist on PaperLens.">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <Header current="home" />

  <div class="term">
    <section class="shell boot" aria-label="Not found">
      <p class="line hero-code" aria-hidden="true">4<span>0</span>4</p>
      <p class="line prompt cmd" id="pl-404-cmd">cd .</p>
      <p class="line err" id="pl-404-err">bash: cd: No such file or directory</p>
      <p class="line gap" aria-hidden="true"></p>
      <p class="line prompt cmd">ls ~/papers | head -3</p>
      {suggestions.map((s) => (
        <p class="line hit">
          <a href={`/idea/${s.slug}/`}>{s.file}</a>
          <span class="dim">// {s.subtitle}</span>
        </p>
      ))}
      <p class="line gap" aria-hidden="true"></p>
      <p class="line prompt cmd">cd ~ <span class="cursor"></span></p>
    </section>

    <p style="margin:0 0 1.5rem">
      <a class="btn primary" href="/">Back to ~/papers <span class="kbd">⏎</span></a>
      <a class="btn" href="/#papers">Search all entries <span class="kbd">/</span></a>
    </p>

<pre class="cow" aria-hidden="true">
 ________________________________________
/ The page you wanted is not in the      \
\ index. The papers are. Try / to filter. /
 ----------------------------------------
        \   ^__^
         \  (oo)\_______
            (__)\       )\/\
                ||----w |
                ||     ||
</pre>
  </div>

  <Footer path="/404" exitCode="exit 1" keys="<b>⏎</b> home &nbsp; <b>/</b> papers &nbsp; <b>?</b> keys" />
  <HelpOverlay />
</BaseLayout>

<script>
  // report the path the reader actually asked for
  const show = () => {
    const path = window.location.pathname + window.location.search;
    const cmd = document.getElementById('pl-404-cmd');
    const err = document.getElementById('pl-404-err');
    if (cmd) cmd.textContent = `cd ${path}`;
    if (err) err.textContent = `bash: cd: ${path}: No such file or directory`;
    const status = document.querySelector('.statusbar .seg:nth-child(2)');
    if (status) status.textContent = path;
  };
  show();
  document.addEventListener('astro:page-load', show);

  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement | null;
    if (e.key !== 'Enter' || e.metaKey || e.ctrlKey) return;
    if (el?.matches?.('input, textarea, a, button')) return;
    if (document.getElementById('pl-help')?.hasAttribute('open')) return;
    window.location.href = '/';
  });
</script>
