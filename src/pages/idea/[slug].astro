---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HelpOverlay from '../../components/HelpOverlay.astro';
import DemoView from '../../components/react/DemoView';
import EntryThumb from '../../components/react/EntryThumb';

export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  const sorted = ideas.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((idea, i) => ({
    params: { slug: idea.slug },
    props: {
      idea,
      newer: sorted[i - 1] ?? null,
      older: sorted[i + 1] ?? null,
      siblings: sorted
        .filter((other) => other.slug !== idea.slug)
        .map((other) => ({
          slug: other.slug,
          title: other.data.title,
          date: other.data.date,
          tags: other.data.tags,
        })),
    },
  }));
}

interface Props {
  idea: CollectionEntry<'ideas'>;
  newer: CollectionEntry<'ideas'> | null;
  older: CollectionEntry<'ideas'> | null;
  siblings: { slug: string; title: string; date: Date; tags: string[] }[];
}

const { idea, newer, older, siblings } = Astro.props;
const { title, subtitle, status, date, tags, simulation, coverImage, webUrl, githubUrl, category, impact, readTime } =
  idea.data;

const { Content, headings } = await idea.render();

const iso = (d: Date) => d.toISOString().slice(0, 10);
const extension = idea.id.endsWith('.mdx') ? 'mdx' : 'md';

// arXiv abstract links point at the PDF
const pdfUrls = (idea.data.pdfUrl ?? '')
  .split(',')
  .map((url) => url.split('#')[0].trim())
  .filter(Boolean)
  .map((url) => (url.includes('arxiv.org/abs/') ? url.replace('/abs/', '/pdf/') : url));

const hostOf = (url: string) => {
  try {
    const u = new URL(url);
    return (u.hostname + u.pathname).replace(/^www\./, '');
  } catch {
    return url;
  }
};

// views: documentation is always there; the rest depend on the entry
const views = [
  { id: 'doc', label: 'documentation' },
  ...pdfUrls.map((_, i) => ({ id: `pdf-${i}`, label: pdfUrls.length > 1 ? `pdf ${i + 1}` : 'pdf' })),
  ...(webUrl ? [{ id: 'web', label: 'website' }] : []),
  ...(githubUrl ? [{ id: 'src', label: 'source' }] : []),
];

// related: most shared tags, then most recent
const tagSet = new Set(tags.map((t) => t.toLowerCase()));
const related = siblings
  .map((s) => ({ ...s, shared: s.tags.filter((t) => tagSet.has(t.toLowerCase())).length }))
  .filter((s) => s.shared > 0)
  .sort((a, b) => b.shared - a.shared || b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 3);

const helpKeys = views.length > 1 ? [{ key: 'gt / gT', what: 'next / previous view' }] : [];
---

<BaseLayout {title} description={subtitle} image={coverImage} type="article" {date}>
  <Header current="papers" />

  <div class="term">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">~</a> / <a href="/#papers">papers</a> / <span class="cur">{idea.slug}.{extension}</span>
    </nav>

    <div class="layout">
      <article>
        <header class="doc-head">
          <div class="meta row-meta">
            <span class={`chip status-${status}`}>{status}</span>
            <span class={`cat cat-${category}`}>{category}</span>
            <span>{iso(date)}</span>
            <span>{readTime} read</span>
            {simulation && <span class="c-green">sim</span>}
            {pdfUrls[0] && (
              <a href={pdfUrls[0]} target="_blank" rel="noopener noreferrer">{hostOf(pdfUrls[0])}</a>
            )}
          </div>
          <h1>{title}</h1>
          <p class="sub">{subtitle}</p>
          <p class="tags">
            {tags.map((tag) => <span class="tag">{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
          </p>
        </header>

        <!-- The simulation sits in the reading flow, once, above the document -->
        {simulation ? (
          <section class="pane sunken sim-pane" id="simulation" aria-labelledby="sim-title">
            <h2 class="pane-title" id="sim-title">
              <span class="hl">simulation</span><span class="extra">{simulation}</span>
            </h2>
            <div class="pane-title-r"><span class="c-aqua">● running</span></div>
            <div class="sim-host">
              {/* client:only — the simulations are interactive by nature, and several
                  seed themselves randomly, which server rendering cannot match */}
              <DemoView client:only="react" simulationName={simulation} />
            </div>
            <p class="sim-note">Runs in your browser. Change a parameter and the figure changes with it.</p>
          </section>
        ) : (
          <section class="pane sunken sim-pane" aria-label="Entry figure">
            <h2 class="pane-title"><span class="hl">figure</span><span class="extra">no simulation yet</span></h2>
            <EntryThumb client:visible slug={idea.slug} category={category} animated />
          </section>
        )}

        <!-- Views -->
        <div class="viewstrip" role="tablist" aria-label="Views">
          {views.map((view, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`view-${view.id}`}
              id={`tab-${view.id}`}
            >
              {view.label}
            </button>
          ))}
        </div>

        <div class="viewpanel doc" id="view-doc" role="tabpanel" aria-labelledby="tab-doc">
          <Content />

          <nav class="endnav" aria-label="Adjacent entries">
            {newer ? (
              <a href={`/idea/${newer.slug}/`}><span class="k">← newer</span> {newer.data.title}</a>
            ) : (
              <span />
            )}
            {older ? (
              <a href={`/idea/${older.slug}/`}>{older.data.title} <span class="k">older →</span></a>
            ) : (
              <span />
            )}
          </nav>
        </div>

        {pdfUrls.map((url, i) => (
          <div class="viewpanel" id={`view-pdf-${i}`} role="tabpanel" aria-labelledby={`tab-pdf-${i}`} hidden>
            <div class="pdfbox">
              <p class="prompt" style="margin:0 0 .75rem;color:var(--fg1)">open {hostOf(url)}</p>
              <iframe src={url} title={`${title} — source PDF ${i + 1}`} loading="lazy"></iframe>
              <p style="margin:.75rem 0 0">
                <a class="btn" href={url} target="_blank" rel="noopener noreferrer">Open in a new tab</a>
              </p>
            </div>
          </div>
        ))}

        {webUrl && (
          <div class="viewpanel" id="view-web" role="tabpanel" aria-labelledby="tab-web" hidden>
            <p class="dim">The project's own site, outside PaperLens.</p>
            <p style="margin-top:.75rem">
              <a class="btn primary" href={webUrl} target="_blank" rel="noopener noreferrer">{hostOf(webUrl)}</a>
            </p>
          </div>
        )}

        {githubUrl && (
          <div class="viewpanel" id="view-src" role="tabpanel" aria-labelledby="tab-src" hidden>
            <p class="dim">Reference implementation.</p>
            <p style="margin-top:.75rem">
              <a class="btn primary" href={githubUrl} target="_blank" rel="noopener noreferrer">{hostOf(githubUrl)}</a>
            </p>
          </div>
        )}
      </article>

      <aside class="side" aria-label="Entry sidebar">
        {toc.length > 1 && (
          <section class="pane">
            <h2 class="pane-title"><span>:toc</span></h2>
            <ol class="toc">
              {toc.map((h) => (
                <li class={h.depth >= 3 ? 'l3' : undefined}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section class="pane">
          <h2 class="pane-title"><span>meta</span></h2>
          <dl class="kv">
            <dt>status</dt>
            <dd><span class={`chip status-${status}`}>{status}</span></dd>
            <dt>type</dt>
            <dd class={`cat cat-${category}`}>{category}</dd>
            <dt>impact</dt>
            <dd>{impact}</dd>
            <dt>read</dt>
            <dd>{readTime}</dd>
            {simulation && (
              <>
                <dt>sim</dt>
                <dd class="c-green">{simulation}</dd>
              </>
            )}
            {pdfUrls.map((url) => (
              <>
                <dt>pdf</dt>
                <dd><a href={url} target="_blank" rel="noopener noreferrer">{hostOf(url)}</a></dd>
              </>
            ))}
            <dt>updated</dt>
            <dd>{iso(date)}</dd>
          </dl>
        </section>

        {related.length > 0 && (
          <section class="pane">
            <h2 class="pane-title"><span>related</span><span class="extra">by tag</span></h2>
            <ul class="related">
              {related.map((entry) => (
                <li>
                  <span class="d">{iso(entry.date).slice(0, 7)}</span>
                  <a href={`/idea/${entry.slug}/`}>{entry.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>

  <Footer
    path={`~/papers/${idea.slug}.${extension}`}
    meta={`${category} · ${status} · ${readTime}`}
    keys={
      views.length > 1
        ? '<b>gt</b> next view &nbsp; <b>gg</b>/<b>G</b> top/end &nbsp; <b>?</b> keys'
        : '<b>gg</b>/<b>G</b> top/end &nbsp; <b>?</b> keys'
    }
    scrollMeter
  />
  <HelpOverlay extra={helpKeys} />
</BaseLayout>
