---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TabsController from '../../components/react/TabsController';
import DemoView from '../../components/react/DemoView';

export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  return ideas.map((idea) => ({
    params: { slug: idea.slug },
    props: { idea },
  }));
}

interface Props {
  idea: CollectionEntry<'ideas'>;
}

const { idea } = Astro.props;
const { title, subtitle, status, date, tags, simulation, coverImage, webUrl, githubUrl } = idea.data;
let { pdfUrl } = idea.data;
const { Content } = await idea.render();

// Parse comma-delimited PDF URLs and convert arXiv abstract URLs to PDF URLs
let pdfUrls: string[] = [];
if (pdfUrl) {
  pdfUrls = pdfUrl.split(',').map(url => {
    const trimmed = url.trim();
    return trimmed.includes('arxiv.org/abs/') ? trimmed.replace('/abs/', '/pdf/') : trimmed;
  });
}

const statusColors: Record<string, string> = {
  RESEARCH: 'bg-purple-500/20 text-purple-400 border-purple-500/30',
  CONCEPT: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  PROTOTYPE: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
  ALPHA: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  ARCHIVED: 'bg-zinc-500/20 text-zinc-400 border-zinc-500/30',
};

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Build tab metadata
const tabs = [
  { id: 'paper', label: 'Documentation' },
];

if (simulation) {
  tabs.push({ id: 'simulation', label: 'Simulation' });
}

if (pdfUrls.length > 0) {
  if (pdfUrls.length === 1) {
    tabs.push({ id: 'pdf', label: 'PDF' });
  } else {
    pdfUrls.forEach((_, idx) => {
      tabs.push({ id: `pdf-${idx}`, label: `PDF ${idx + 1}` });
    });
  }
}

if (webUrl) {
  tabs.push({ id: 'website', label: 'Website' });
}

if (githubUrl) {
  tabs.push({ id: 'github', label: 'GitHub' });
}
---

<BaseLayout
  title={title}
  description={subtitle}
  image={coverImage}
  type="article"
  date={date}
>
  <Header />

  <div class="min-h-screen">
    <article class="max-w-4xl mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm font-mono">
        <a href="/" class="text-zinc-500 hover:text-zinc-300">Home</a>
        <span class="text-zinc-700 mx-2">/</span>
        <span class="text-zinc-400">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class={`px-2 py-0.5 text-[10px] font-mono uppercase border rounded ${statusColors[status]}`}>
            {status}
          </span>
          <span class="text-xs text-zinc-500 font-mono">{formattedDate}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-zinc-100 mb-4">
          {title}
        </h1>
        <p class="text-lg text-zinc-400">{subtitle}</p>
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="px-2 py-1 text-xs font-mono text-zinc-500 bg-zinc-800/50 rounded">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Cover Image or Simulation -->
      {simulation ? (
        <div class="mb-8">
          <DemoView client:visible simulationName={simulation} />
        </div>
      ) : (
        <div class="aspect-video overflow-hidden rounded-lg border border-zinc-800 mb-8">
          <img
            src={coverImage}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Tabbed Content -->
      <div class="w-full">
        <TabsController client:load tabs={tabs} />

        <!-- Documentation Tab -->
        <div id="tab-panel-paper" class="mt-6">
          <div class="prose prose-invert prose-zinc max-w-none prose-headings:font-heading prose-code:font-mono prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800">
            <Content />
          </div>
        </div>

        <!-- Simulation Tab -->
        {simulation && (
          <div id="tab-panel-simulation" class="mt-6" style="display: none;">
            <DemoView client:visible simulationName={simulation} />
          </div>
        )}

        <!-- PDF Tabs -->
        {pdfUrls.length === 1 && (
          <div id="tab-panel-pdf" class="mt-6" style="display: none;">
            <div class="w-full">
              <iframe
                src={pdfUrls[0]}
                class="w-full h-[800px] border border-zinc-800 rounded-lg"
                title={`${title} - PDF`}
              />
            </div>
          </div>
        )}
        {pdfUrls.length > 1 && pdfUrls.map((url, idx) => (
          <div id={`tab-panel-pdf-${idx}`} class="mt-6" style="display: none;">
            <div class="w-full">
              <iframe
                src={url}
                class="w-full h-[800px] border border-zinc-800 rounded-lg"
                title={`${title} - PDF ${idx + 1}`}
              />
            </div>
          </div>
        ))}

        <!-- Website Tab -->
        {webUrl && (
          <div id="tab-panel-website" class="mt-6" style="display: none;">
            <div class="flex flex-col items-start gap-4">
              <p class="text-zinc-400">Visit the official project website or demo.</p>
              <a
                href={webUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 border border-zinc-700 text-zinc-300 hover:bg-zinc-800 transition-colors font-mono text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Open Website
              </a>
            </div>
          </div>
        )}

        <!-- GitHub Tab -->
        {githubUrl && (
          <div id="tab-panel-github" class="mt-6" style="display: none;">
            <div class="flex flex-col items-start gap-4">
              <p class="text-zinc-400">View the source code and implementation on GitHub.</p>
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 border border-zinc-700 text-zinc-300 hover:bg-zinc-800 transition-colors font-mono text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                View on GitHub
              </a>
            </div>
          </div>
        )}
      </div>
    </article>
  </div>

  <Footer />
</BaseLayout>
