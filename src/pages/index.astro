---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IdeaCard from '../components/IdeaCard.astro';
import GlobeAnimation from '../components/react/GlobeAnimation';
import ScrambleText from '../components/react/ScrambleText';
import { Lightbulb, FileText } from 'lucide-react';

const allIdeas = await getCollection('ideas');
const sortedIdeas = allIdeas.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = sortedIdeas.find((idea) => idea.data.featured);
const papers = sortedIdeas.filter((i) => i.data.category === 'paper');
const ideas = sortedIdeas.filter((i) => i.data.category === 'idea');
---

<BaseLayout
  title="Research Lab"
  description="Xavier Geerinck's research lab exploring AI, systems, and beyond."
>
  <Header />

  <div class="pt-20 min-h-screen">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 py-16">
      <div class="flex flex-col md:flex-row items-start gap-12">
        <!-- Left: Identity and Content -->
        <div class="flex-1 space-y-6">
          <!-- Avatar and Name -->
          <div class="flex items-center gap-4">
            <img
              src="https://media.licdn.com/dms/image/v2/D4E03AQGjTswEo5o8mw/profile-displayphoto-shrink_800_800/B4EZP5sG2lqgAc-/0/1735902757303?e=1742428800&v=beta&t=gHRvQ8Zf8D_9dXRd5JbWTxlQJpn-Q5-C4dJKHnOQFws"
              alt="Xavier Geerinck"
              class="w-20 h-20 rounded-full border-2 border-indigo-500"
            />
            <div>
              <h1 class="text-3xl font-heading font-bold text-zinc-100">
                Xavier Geerinck
              </h1>
              <p class="text-sm text-zinc-400 font-mono">
                CTO | PaperLens
              </p>
            </div>
          </div>

          <!-- Research Directive -->
          <div class="space-y-2">
            <p class="text-xs font-mono text-zinc-500 uppercase tracking-wider">
              Research Directive 2026
            </p>
            <h2 class="text-4xl md:text-5xl font-heading font-bold text-zinc-100">
              BUILDING THE <ScrambleText client:load text="IMPOSSIBLE" />
            </h2>
          </div>

          <!-- Description -->
          <p class="text-lg text-zinc-400 leading-relaxed max-w-2xl">
            Welcome to PaperLens. I am Xavier Geerinck, and this is my research lab for exploring advanced software concepts, architectural patterns, and experimental prototypes.
          </p>
        </div>

        <!-- Right: Globe with Metadata -->
        <div class="flex flex-col items-center gap-4">
          <!-- Clearance and Location -->
          <div class="text-xs font-mono text-zinc-500 space-y-1 text-center">
            <div>
              <span class="text-zinc-600">Clearance</span>
              <span class="mx-2">-</span>
              <span class="text-indigo-400">Sovereign</span>
            </div>
            <div>
              <span class="text-zinc-600">Location</span>
              <span class="mx-2">-</span>
              <a
                href="https://scrydon.co"
                target="_blank"
                rel="noopener noreferrer"
                class="text-indigo-400 hover:text-indigo-300 transition-colors"
              >
                Scrydon
              </a>
            </div>
          </div>

          <!-- Globe Animation -->
          <div class="w-96 h-96">
            <GlobeAnimation client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {featured && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <span class="w-2 h-2 rounded-full bg-indigo-500" />
          Featured Research
        </div>
        <IdeaCard idea={featured} variant="featured" />
      </section>
    )}

    <!-- My Thoughts -->
    {ideas.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <Lightbulb className="w-4 h-4" />
          My Thoughts
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {ideas.filter((i) => i.slug !== featured?.slug).map((idea) => (
            <IdeaCard idea={idea} />
          ))}
        </div>
      </section>
    )}

    <!-- Papers -->
    {papers.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <FileText className="w-4 h-4" />
          Papers
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {papers.filter((i) => i.slug !== featured?.slug).map((idea) => (
            <IdeaCard idea={idea} />
          ))}
        </div>
      </section>
    )}
  </div>

  <Footer />
</BaseLayout>
