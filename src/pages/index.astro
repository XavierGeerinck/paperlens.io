---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IdeaCard from '../components/IdeaCard.astro';
import GlobeAnimation from '../components/react/GlobeAnimation';
import ScrambleText from '../components/react/ScrambleText';
import { Lightbulb, FileText, Terminal, FlaskConical, Network, Database, BookOpen } from 'lucide-react';

const allIdeas = await getCollection('ideas');
const sortedIdeas = allIdeas.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = sortedIdeas.find((idea) => idea.data.featured);
const deepDives = sortedIdeas.filter((i) => i.data.category === 'deep-dive');
const papers = sortedIdeas.filter((i) => i.data.category === 'paper');
const ideas = sortedIdeas.filter((i) => i.data.category === 'idea');
---

<BaseLayout
  title="Research Lab"
  description="Xavier Geerinck's research lab exploring AI, systems, and beyond."
>
  <Header />

  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Top Bar: Avatar, Name, Clearance -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-zinc-800/50 pb-8 mb-8">
          <div class="flex items-center gap-4">
            <div class="relative group">
              <div class="w-14 h-14 bg-zinc-900 border border-zinc-700 overflow-hidden grayscale group-hover:grayscale-0 transition-all duration-500">
                <img
                  alt="Xavier Geerinck"
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100"
                  src="https://github.com/xaviergeerinck.png"
                />
              </div>
              <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-zinc-950"></div>
            </div>
            <div>
              <h2 class="text-base font-bold text-white font-mono tracking-wider uppercase">
                Xavier Geerinck
              </h2>
              <div class="text-[10px] text-indigo-400 font-mono uppercase tracking-widest flex items-center gap-2 mt-1">
                <Terminal className="w-3 h-3" />
                <span>CTO</span>
                <span class="text-zinc-700">|</span>
                <span>PaperLens</span>
              </div>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="px-4 py-2 bg-zinc-900/50 border border-zinc-800">
              <div class="text-[9px] text-zinc-500 font-mono uppercase tracking-widest mb-1">
                Clearance
              </div>
              <div class="text-xs text-zinc-300 font-mono font-bold">Sovereign</div>
            </div>
            <div class="px-4 py-2 bg-zinc-900/50 border border-zinc-800 hidden sm:block">
              <div class="text-[9px] text-zinc-500 font-mono uppercase tracking-widest mb-1">
                Location
              </div>
              <div class="text-xs text-zinc-300 font-mono font-bold">
                <a
                  href="https://scrydon.co"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-indigo-400 transition-colors"
                >
                  Scrydon
                </a>
              </div>
            </div>
            <div class="px-4 py-2 bg-zinc-900/50 border border-zinc-800 hidden md:block group cursor-help" title="Try it...">
              <div class="text-[9px] text-zinc-500 font-mono uppercase tracking-widest mb-1">
                Override
              </div>
              <div class="text-xs text-zinc-600 group-hover:text-zinc-400 font-mono font-bold transition-colors">
                ↑↑↓↓←→←→BA
              </div>
            </div>
          </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Left: Content (2/3) -->
          <div class="lg:col-span-2 flex flex-col gap-6">
            <div class="inline-flex items-center gap-2 px-2 py-1 bg-indigo-500/10 border border-indigo-500/20 w-fit">
              <FlaskConical className="w-3 h-3 text-indigo-400" />
              <span class="text-[10px] font-mono text-indigo-300 uppercase tracking-widest">
                Research Directive 2026
              </span>
            </div>
            <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight font-heading max-w-4xl leading-none">
              BUILDING THE<br />
              <span class="text-indigo-500">
                <ScrambleText client:load text="IMPOSSIBLE" />
              </span>
            </h1>
            <div class="mt-4">
              <p class="text-lg text-zinc-400 font-light leading-relaxed max-w-2xl">
                Welcome to PaperLens. I am <strong>Xavier Geerinck</strong>, and this is my research lab for exploring advanced software concepts, architectural patterns, and experimental prototypes.
              </p>
            </div>
          </div>

          <!-- Right: Globe (1/3) -->
          <div class="lg:col-span-1 relative hidden lg:block">
            <div class="absolute inset-y-0 left-0 border-l border-zinc-800/50 -my-20"></div>
            <div class="h-full min-h-[500px] flex items-center justify-center -mt-20">
              <div class="w-full h-full min-h-[400px] flex flex-col items-center justify-center relative group">
                <!-- Glow Effect -->
                <div class="absolute inset-0 bg-indigo-500/5 blur-3xl rounded-full transform scale-75"></div>

                <!-- Globe -->
                <div class="w-full h-full max-w-[300px] max-h-[300px] z-10">
                  <GlobeAnimation client:load />
                </div>

                <!-- Bottom Metadata -->
                <div class="absolute bottom-10 left-0 right-0 flex justify-center gap-8">
                  <div class="flex flex-col items-center gap-1">
                    <div class="flex items-center gap-2 text-indigo-400">
                      <Network className="w-4 h-4" />
                      <span class="text-xs font-mono font-bold">GLOBAL_NET</span>
                    </div>
                    <span class="text-[10px] text-zinc-500 font-mono uppercase tracking-widest">
                      Scanning
                    </span>
                  </div>
                  <div class="w-px h-8 bg-zinc-800"></div>
                  <div class="flex flex-col items-center gap-1">
                    <div class="flex items-center gap-2 text-emerald-400">
                      <Database className="w-4 h-4" />
                      <span class="text-xs font-mono font-bold">ARXIV_DB</span>
                    </div>
                    <span class="text-[10px] text-zinc-500 font-mono uppercase tracking-widest">
                      Connected
                    </span>
                  </div>
                </div>

                <!-- Floating Notification -->
                <div class="absolute top-1/4 left-1/2 -translate-x-1/2 bg-zinc-900/80 backdrop-blur border border-zinc-800 p-2 rounded text-xs font-mono text-zinc-300 animate-pulse">
                  <div class="flex items-center gap-2">
                    <FileText className="w-3 h-3 text-indigo-400" />
                    <span>Indexing New Research...</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {featured && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <span class="w-2 h-2 rounded-full bg-indigo-500" />
          Featured Research
        </div>
        <IdeaCard idea={featured} variant="featured" />
      </section>
    )}

    <!-- My Thoughts -->
    {ideas.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <Lightbulb className="w-4 h-4" />
          My Thoughts
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {ideas.filter((i) => i.slug !== featured?.slug).map((idea) => (
            <IdeaCard idea={idea} />
          ))}
        </div>
      </section>
    )}

    <!-- Deep Dive -->
    {deepDives.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <BookOpen className="w-4 h-4" />
          Deep Dive
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {deepDives.filter((i) => i.slug !== featured?.slug).map((idea) => (
            <IdeaCard idea={idea} />
          ))}
        </div>
      </section>
    )}

    <!-- Papers -->
    {papers.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex items-center gap-2 mb-6 text-xs font-mono text-zinc-500 uppercase">
          <FileText className="w-4 h-4" />
          Papers
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {papers.filter((i) => i.slug !== featured?.slug).map((idea) => (
            <IdeaCard idea={idea} />
          ))}
        </div>
      </section>
    )}
  </div>

  <Footer />
</BaseLayout>
