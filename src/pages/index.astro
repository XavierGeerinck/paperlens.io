---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HelpOverlay from '../components/HelpOverlay.astro';
import PaperBrowser from '../components/react/PaperBrowser';
import EntryThumb from '../components/react/EntryThumb';
import { groupByTag, tagSlug } from '../lib/tags';

const iso = (d: Date) => d.toISOString().slice(0, 10);

const all = await getCollection('ideas');
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entries = sorted.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  subtitle: entry.data.subtitle,
  date: iso(entry.data.date),
  status: entry.data.status,
  category: entry.data.category,
  impact: entry.data.impact,
  readTime: entry.data.readTime,
  tags: entry.data.tags,
  hasSim: Boolean(entry.data.simulation),
  pdfUrl: entry.data.pdfUrl?.split(',')[0]?.trim(),
  githubUrl: entry.data.githubUrl,
  webUrl: entry.data.webUrl,
  featured: entry.data.featured,
}));

// the newest featured entry leads; if none is flagged, the newest entry does
const featured = entries.find((e) => e.featured) ?? entries[0];
const latest = entries.slice(0, 8);

const simCount = entries.filter((e) => e.hasSim).length;
const pdfCount = entries.filter((e) => e.pdfUrl).length;
const lastPush = entries[0]?.date;

const tagGroups = groupByTag(sorted);
const topTags = tagGroups.slice(0, 8);
const maxTag = topTags[0]?.entries.length ?? 1;
const hubCount = tagGroups.filter((g) => g.entries.length > 1).length;

/**
 * The listing itself, for the crawlers: the home page is the index of the
 * archive, so it says so in schema rather than leaving it to be inferred from
 * thirty anchors.
 */
const listSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'PaperLens entries',
    numberOfItems: entries.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: entries.map((entry, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/idea/${entry.slug}/`, Astro.site).href,
      name: entry.title,
    })),
  },
];

const helpKeys = [
  { key: 'j / k', what: 'move down / up the list' },
  { key: '⏎ / l', what: 'open the selected entry' },
  { key: 'a p d i', what: 'all · papers · deep-dives · ideas' },
];
---

<BaseLayout
  title="PaperLens — Papers and research for AI engineers, visualized"
  description="Every entry rebuilds a paper's core mechanism as an interactive simulation, beside the math and the code: JEPA, DeepSeek, quantization, lithography and more."
  schema={listSchema}
>
  <Header current="home" count={entries.length} />

  <div class="term">
    <!-- Hero: the boot sequence. The figlet banner is the logo. -->
    <section class="hero" aria-label="Introduction">
      <div class="boot">
        <p class="ps1 line">
          <span class="u">xavier</span><span class="role">[cto]</span>@<span class="h">paperlens</span>
          <span class="d">$</span> <span class="typed cmd">ls ~/papers</span>
        </p>
<pre class="figlet line" aria-label="paperlens">
                              _
  _ __   __ _ _ __   ___ _ __| | ___ _ __  ___
 | '_ \ / _` | '_ \ / _ \ '__| |/ _ \ '_ \/ __|
 | |_) | (_| | |_) |  __/ |  | |  __/ | | \__ \
 | .__/ \__,_| .__/ \___|_|  |_|\___|_| |_|___/
 |_|         |_|                               </pre>
        <h1 class="tagline line cmt"><span class="sr-only">PaperLens: </span>papers and research for AI engineers, visualized.</h1>
        <p class="tagline line cmt">
          every entry ships with a simulation, the math, and the code — drag a slider instead of trusting a figure.
        </p>
        <div class="stats line">
          <p class="ok">{entries.length} entries indexed</p>
          <p class="ok">{simCount} simulations loaded</p>
          <p class="ok">{pdfCount} source pdfs linked</p>
          <p class="ok">last push <span class="c-green">{lastPush}</span></p>
        </div>
      </div>

      <!-- whoami -->
      <section class="pane" id="whoami" aria-labelledby="whoami-title">
        <h2 class="pane-title" id="whoami-title"><span>whoami</span></h2>
        <div class="who">
          <div class="avatar" aria-hidden="true">xg</div>
          <div>
            <div>
              <b>Xavier Geerinck</b>
              <span class="dim">
                — CTO @ <a href="https://scrydon.com" target="_blank" rel="noopener noreferrer">Scrydon</a>, Belgium
              </span>
            </div>
            <p>
              I read the papers, then rebuild the core mechanism as something you can poke at. If a claim survives a
              slider, it's probably true. Always open to collaborating on hard problems.
            </p>
            <div class="links">
              <a href="https://github.com/xaviergeerinck" target="_blank" rel="noopener noreferrer">github</a>
              <a href="https://twitter.com/XavierGeerinck" target="_blank" rel="noopener noreferrer">x</a>
              <a href="https://linkedin.com/in/xaviergeerinck" target="_blank" rel="noopener noreferrer">linkedin</a>
              <a href="https://xaviergeerinck.com" target="_blank" rel="noopener noreferrer">xaviergeerinck.com</a>
              <a href="mailto:xavier@m18x.com">mail</a>
            </div>
          </div>
        </div>
      </section>
    </section>

    <div class="grid-2">
      <!-- Featured -->
      {featured && (
        <section class="pane feat" aria-labelledby="featured-title">
          <h2 class="pane-title"><span class="hl">featured</span><span class="extra">{featured.slug}.md</span></h2>
          <EntryThumb client:visible slug={featured.slug} category={featured.category} animated />
          <h3 id="featured-title"><a href={`/idea/${featured.slug}/`}>{featured.title}</a></h3>
          <p class="sub">{featured.subtitle}</p>
          <div class="row-meta">
            <span class={`chip status-${featured.status}`}>{featured.status}</span>
            <span class={`cat cat-${featured.category}`}>{featured.category}</span>
            <span>{featured.date}</span>
            <span>{featured.readTime} read</span>
            {featured.hasSim && <span class="c-green">sim</span>}
            {featured.pdfUrl && <span class="c-aqua">pdf</span>}
          </div>
          <div class="actions">
            <a class="btn primary" href={`/idea/${featured.slug}/`}>Read</a>
            {featured.hasSim && (
              <a class="btn" href={`/idea/${featured.slug}/#simulation`}>Run simulation</a>
            )}
            {featured.pdfUrl && (
              <a class="btn" href={featured.pdfUrl} target="_blank" rel="noopener noreferrer">Source PDF</a>
            )}
          </div>
        </section>
      )}

      <!-- Latest + tag histogram -->
      <section class="pane" aria-labelledby="latest-title">
        <h2 class="pane-title" id="latest-title"><span>latest</span><span class="extra">newest first</span></h2>
        <ol class="gitlog">
          {latest.map((entry, i) => (
            <li>
              <span class="when">{entry.date}</span>
              <span class="msg">
                {i === 0 && <span class="head">new</span>}
                <span class="scope">{entry.category}:</span>
                <a href={`/idea/${entry.slug}/`}>{entry.title}</a>
              </span>
            </li>
          ))}
        </ol>

        <p class="dim" style="margin:.9rem 0 0;font-size:var(--fs-sm)">
          Subscribe to the feed: <a href="/rss.xml">/rss.xml</a>
        </p>

        <hr class="hr" style="margin:1rem 0 .9rem" />

        <p class="prompt" style="margin:0 0 .4rem;font-size:var(--fs-sm);color:var(--fg1)">
          tags | sort | uniq -c | sort -rn | head -8
        </p>
        <ol class="uniq">
          {topTags.map((group) => (
            <li>
              <span class="n">{group.entries.length}</span>
              <a href={`/tags/${group.slug}/`}>{group.slug}</a>
              <span class="bar" aria-hidden="true">
                {'█'.repeat(Math.max(1, Math.round((group.entries.length / maxTag) * 8)))}
              </span>
            </li>
          ))}
        </ol>

        <p class="dim" style="margin:.7rem 0 0;font-size:var(--fs-sm)">
          All <a href="/tags/">{tagGroups.length} tags</a>, {hubCount} of them shared by more than one entry.
        </p>
      </section>
    </div>

    <!-- The browser: every entry, one screen, keyboard-driven -->
    <section class="pane" id="papers" aria-labelledby="papers-title" style="margin-top:1.5rem">
      <h2 class="pane-title" id="papers-title"><span class="hl">~/papers</span><span class="extra">{entries.length} entries</span></h2>
      <div class="pane-title-r">sorted by date ↓</div>
      <PaperBrowser client:load entries={entries} />
    </section>
  </div>

  <Footer
    path="~/papers"
    position={`1/${entries.length}`}
    keys="<b>j</b>/<b>k</b> move &nbsp; <b>⏎</b> open &nbsp; <b>/</b> filter &nbsp; <b>?</b> keys"
  />
  <HelpOverlay extra={helpKeys} />
</BaseLayout>
